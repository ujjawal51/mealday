MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mealday
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development

# Production account creation is disabled unless explicitly enabled.
ALLOW_REGISTRATION=false

# Hosted deployment: use a cloud MongoDB URI in the host's secret settings.
# Render supplies RENDER_EXTERNAL_URL and PORT; APP_ORIGIN can override its public origin.
# Production defaults HOST to 0.0.0.0 when HOST is unset.
# Only when retaining the Sites URL through the server gateway:
# MEALDAY_PROXY_SECRET=<same private random value on Node host and Site>
# Site-only runtime setting: MEALDAY_BACKEND_URL=<actual HTTPS Node service origin>
