{
  "name": "mealday-app",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "node --env-file-if-exists=.env phone-preview/server/index.mjs",
    "build": "node scripts/build.cjs",
    "recipes:import": "node --env-file-if-exists=.env phone-preview/server/import-recipes.mjs",
    "start:legacy": "node scripts/serve.cjs",
    "test:phone": "node --test phone-preview/server/*.test.mjs",
    "build:phone": "node phone-preview/scripts/build-client.mjs",
    "audit:kitchen": "node phone-preview/scripts/audit-kitchen-tests.mjs",
    "test:kitchen": "node --test phone-preview/source/kitchen-tests/quality.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "google-auth-library": "^11.3.4",
    "leaflet": "1.9.4",
    "mongodb": "^7.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
